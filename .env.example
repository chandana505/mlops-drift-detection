# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions

# Producer
PRODUCER_MAX_RECORDS=2000000
PRODUCER_DRIFT_START=1000
PRODUCER_DRIFT_SCALE=5.0
PRODUCER_SLEEP=0.003

# Consumer
CONSUMER_GROUP_ID=drift-detection-group
CONSUMER_AUTO_OFFSET_RESET=earliest
CONSUMER_BATCH_SIZE=100
REFERENCE_REFRESH_EVERY=0
LATENCY_BASELINE_BATCHES=5

# Email alerts (optional — leave password empty to skip email)
ALERT_EMAIL_SENDER=mtechproject2001@gmail.com
ALERT_EMAIL_RECEIVER=mtechproject2001@gmail.com
ALERT_EMAIL_PASSWORD=''